.page {
  padding: 0 calc(28rpx + var(--sar)) calc(40rpx + var(--sab)) calc(28rpx + var(--sal));
}

/* —— 头部 —— */
.hero {
  padding: calc(44rpx + var(--sat)) 14rpx 22rpx;
  animation: fadeDown 0.6s ease both;
}
.hero-title {
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  background: linear-gradient(90deg, #FFFFFF, var(--accent), var(--accent-2), #FFFFFF);
  background-size: 300% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  animation: shimmer 6s linear infinite;
}
.hero-sub-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero-sub {
  font-size: 26rpx;
  color: var(--text-sub);
  letter-spacing: 1rpx;
}
.how-btn {
  position: relative;
  flex: none;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent);
  background: rgba(111, 227, 210, 0.12);
  border: 1rpx solid rgba(111, 227, 210, 0.4);
  transition: transform 0.16s ease;
}
/* 热区外扩到 ≥88rpx */
.how-btn::after,
.supply-btn::after,
.si-buy::after,
.switch::after {
  content: '';
  position: absolute;
  left: -14rpx;
  right: -14rpx;
  top: -14rpx;
  bottom: -14rpx;
}
/* 横向排列的胶囊：仅纵向扩展，避免相邻项热区互相覆盖 */
.theme-pill::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -18rpx;
  bottom: -18rpx;
}
/* 快速入口卡：仅纵向扩展，避免相邻卡片热区互相重叠 */
.quick-card::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -14rpx;
  bottom: -14rpx;
}
.how-btn:active {
  transform: scale(0.95);
}
/* —— 皮肤切换 —— */
.theme-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: nowrap;
}
.theme-label {
  flex: none;
  white-space: nowrap;
  font-size: 22rpx;
  color: var(--text-sub);
}
.theme-switch {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1 1 auto;
  min-width: 0;
  /* 纵向留白：避免横向滚动容器裁切药丸的辉光与热区 */
  padding: 18rpx 0;
  margin: -18rpx 0;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.theme-switch::-webkit-scrollbar { display: none; }
.theme-pill {
  position: relative;
  flex: none;
  white-space: nowrap;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-sub);
  background: var(--glass);
  border: 1rpx solid var(--glass-line);
  transition: transform 0.16s, color 0.16s, border-color 0.16s, background 0.16s;
}
.theme-pill.on {
  color: #16213A;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(111, 227, 210, 0.3);
}
.theme-pill:active {
  transform: scale(0.95);
}
.theme-pill.locked {
  color: #FFD86E;
  background: rgba(255, 216, 110, 0.16);
  border-color: rgba(255, 216, 110, 0.45);
}
.row-spacer {
  flex: 0 0 8rpx;
}
.dust-badge {
  flex: none;
  white-space: nowrap;
  font-size: 22rpx;
  font-weight: 800;
  color: #FFD86E;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 12rpx rgba(255, 216, 110, 0.4);
}
.supply-btn {
  position: relative;
  flex: none;
  white-space: nowrap;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
  margin-left: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text);
  background: var(--glass);
  border: 1rpx solid var(--glass-line);
  transition: transform 0.16s ease;
}
.supply-btn:active {
  transform: scale(0.95);
}

/* —— 补给站弹层 —— */
.supply-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(6, 5, 20, 0.84);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 30;
  animation: maskIn 0.3s ease both;
}
@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.supply-card {
  position: relative;
  width: 600rpx;
  max-width: calc(100vw - 64rpx);
  max-height: 82vh;
  border-radius: 36rpx;
  padding: 44rpx 40rpx calc(36rpx + var(--sab));
  display: flex;
  flex-direction: column;
  animation: cardPop 0.5s cubic-bezier(0.18, 1.3, 0.4, 1) both;
}
.supply-list {
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  margin-top: 20rpx;
  max-height: 52vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.supply-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.10);
  border: 1rpx solid var(--glass-line);
}
/* 道具图标：与游戏内背包槽位同源（同字形同色） */
.si-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}
.si-meta {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-right: 14rpx;
}
.si-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}
.si-effect {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  font-variant-numeric: tabular-nums;
}
@keyframes cardPop {
  from { opacity: 0; transform: translateY(30rpx) scale(0.85); }
  to { opacity: 1; transform: none; }
}
.supply-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text);
  text-align: center;
}
.supply-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  text-align: center;
}
.si-buy {
  position: relative;
  min-width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #16213A;
  background: linear-gradient(135deg, #FFD86E, #FFA53D);
  transition: transform 0.16s ease;
}
.si-buy:active {
  transform: scale(0.94);
}
.si-buy.max {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-sub);
}
/* 光尘不足：置灰 + 降低对比，明确不可购买 */
.si-buy.poor {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(243, 241, 255, 0.38);
  border: 1rpx solid var(--glass-line);
  box-shadow: none;
}
@keyframes shimmer {
  0% { background-position: 0% 0; }
  100% { background-position: 300% 0; }
}
@keyframes fadeDown {
  from { opacity: 0; transform: translateY(-18rpx); }
  to { opacity: 1; transform: none; }
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: none; }
}

/* —— 继续游戏 —— */
.continue {
  margin-top: 26rpx;
  height: 86rpx;
  border-radius: 43rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
  font-size: 28rpx;
  font-weight: 700;
  animation: fadeUp 0.6s ease 0.1s both;
  transition: transform 0.18s ease;
}
.continue:active {
  transform: scale(0.97);
}
.continue-ico {
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
}
.continue-ico .ico {
  width: 34rpx;
  height: 34rpx;
  fill: currentColor;
}

/* —— 进度卡 —— */
.progress-card {
  margin-top: 24rpx;
  border-radius: 26rpx;
  padding: 28rpx 32rpx;
  animation: fadeUp 0.6s ease 0.15s both;
}
.progress-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.progress-label {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
}
.progress-num {
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.progress-track {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.10);
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  border-radius: 8rpx;
  box-shadow: 0 0 16rpx rgba(111, 227, 210, 0.6);
  transition: width 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
}

/* —— 分区章节 —— */
.zones {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.zone {
  border-radius: 28rpx;
  padding: 26rpx 28rpx 30rpx;
  animation: fadeUp 0.5s ease both;
}
.zone-head {
  display: flex;
  align-items: center;
}
.zone-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.3), 0 6rpx 16rpx rgba(8, 6, 30, 0.25);
}
.zone-icon .ico {
  width: 40rpx;
  height: 40rpx;
  fill: currentColor;
}
.zone-meta {
  flex: 1;
  margin-left: 20rpx;
}
.zone-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text);
}
.zone-range {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}
.zone-prog {
  text-align: right;
}
.zone-prog-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}
.zone-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.10);
  border-radius: 6rpx;
  overflow: hidden;
  margin-top: 20rpx;
}
.zone-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.zone-locked {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  height: 80rpx;
  color: var(--text-sub);
  font-size: 26rpx;
}
.zone-locked .lock {
  margin-right: 14rpx;
}

/* —— 分区 Tab 导航 —— */
.zone-nav {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.zone-jump {
  position: relative;
  flex: none;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #16213A;
  background: linear-gradient(135deg, #FFD86E, #FFA53D);
  box-shadow: 0 6rpx 16rpx rgba(255, 216, 110, 0.3);
  transition: transform 0.16s ease;
}
.zone-jump::after {
  content: '';
  position: absolute;
  left: -14rpx;
  right: -14rpx;
  top: -14rpx;
  bottom: -14rpx;
}
.zone-jump:active {
  transform: scale(0.94);
}
.zone-tabs {
  flex: 1 1 auto;
  min-width: 0;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.zone-tabs::-webkit-scrollbar { display: none; }
.zone-tab {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  vertical-align: top;
  min-width: 132rpx;
  height: 64rpx;
  padding: 0 20rpx;
  margin-right: 12rpx;
  border-radius: 20rpx;
  background: var(--glass);
  border: 1rpx solid var(--glass-line);
  transition: transform 0.16s ease, color 0.16s ease, background 0.16s ease, border-color 0.16s ease;
}
.zone-tab::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -14rpx;
  bottom: -14rpx;
}
.zone-tab.on {
  color: #16213A;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(111, 227, 210, 0.3);
}
.zone-tab.locked {
  opacity: 0.5;
}
.zt-name {
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 180rpx;
}
.zt-prog {
  margin-top: 2rpx;
  font-size: 18rpx;
  font-weight: 700;
  opacity: 0.8;
  font-variant-numeric: tabular-nums;
}

/* —— 关卡网格 —— */
.grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 18rpx;
}
.cell {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.78);
  animation: cellIn 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  transition: transform 0.18s ease, box-shadow 0.25s ease;
}
.cell:active {
  transform: scale(0.93);
}
@keyframes cellIn {
  from { opacity: 0; transform: translateY(18rpx) scale(0.9); }
  to { opacity: 1; transform: none; }
}
.cell-num {
  font-size: 36rpx;
  font-weight: 700;
}
.cell.done {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  border-color: rgba(255, 255, 255, 0.28);
  box-shadow: 0 8rpx 22rpx rgba(111, 227, 210, 0.30), inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  color: #16213A;
}
.cell.done .cell-num {
  color: #16213A;
}
.cell.locked {
  opacity: 0.45;
  color: transparent;
}
.cell.locked:active {
  transform: none;
}
.cell.current {
  border-color: var(--accent);
  box-shadow: 0 0 0 2rpx var(--accent), 0 8rpx 26rpx rgba(111, 227, 210, 0.40);
  animation: cellIn 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both, pulseRing 2.4s ease-in-out infinite;
}
@keyframes pulseRing {
  0%, 100% { box-shadow: 0 0 0 2rpx var(--accent), 0 8rpx 22rpx rgba(111, 227, 210, 0.30); }
  50% { box-shadow: 0 0 0 4rpx var(--accent), 0 8rpx 34rpx rgba(111, 227, 210, 0.55); }
}

/* 锁 */
.lock {
  position: relative;
  width: 30rpx;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 6rpx;
}
.lock::before {
  content: '';
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 20rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.55);
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
}
/* 可看广告解锁的锁定关：提亮 + 金色虚线框 + 广告角标 */
.cell.locked.ad-open {
  opacity: 0.85;
  border: 2rpx dashed rgba(255, 216, 110, 0.8);
}
.cell.locked.ad-open:active {
  transform: scale(0.93);
}
.ad-tag {
  position: absolute;
  bottom: 8rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 18rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #FFD86E;
}
/* 关卡星级 */
.cell-stars {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 6rpx;
  display: flex;
  justify-content: center;
  gap: 8rpx;
}
.cstar {
  width: 16rpx;
  height: 16rpx;
  background: rgba(0, 0, 0, 0.34);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}
.cstar.on {
  background: #FFD86E;
  box-shadow: 0 0 8rpx rgba(255, 216, 110, 0.75);
}
/* 全收集标记 */
.cell-perfect {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 20rpx;
  font-weight: 800;
  color: #16213A;
  background: #FFD86E;
  box-shadow: 0 0 10rpx rgba(255, 216, 110, 0.75);
}

/* —— 每日挑战 / 成就 入口（P3） —— */
.quick-row {
  margin-top: 20rpx;
  display: flex;
  gap: 18rpx;
}
.quick-card {
  position: relative;
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  padding: 22rpx 22rpx;
  transition: transform 0.18s ease;
}
.quick-card:active {
  transform: scale(0.96);
}
.quick-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  background: rgba(255, 216, 110, 0.16);
}
.quick-icon.ach {
  background: rgba(155, 140, 255, 0.20);
}
.quick-meta {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 16rpx;
}
.quick-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.quick-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.quick-badge {
  flex: none;
  margin-left: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #16213A;
  background: linear-gradient(135deg, #FFD86E, #FFA53D);
}

/* —— 成就 / 设置弹层 —— */
.ach-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(6, 5, 20, 0.84);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 30;
  animation: maskIn 0.3s ease both;
}
.ach-card {
  position: relative;
  width: 620rpx;
  max-width: calc(100vw - 64rpx);
  max-height: 82vh;
  border-radius: 36rpx;
  padding: 40rpx 36rpx calc(32rpx + var(--sab));
  display: flex;
  flex-direction: column;
  animation: cardPop 0.5s cubic-bezier(0.18, 1.3, 0.4, 1) both;
}
/* 右上角关闭 */
.ach-x {
  position: absolute;
  top: 22rpx;
  right: 26rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 28rpx;
  color: var(--text-sub);
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid var(--glass-line);
  z-index: 2;
}
/* 热区外扩到 ≥88rpx */
.ach-x::after {
  content: '';
  position: absolute;
  left: -16rpx;
  right: -16rpx;
  top: -16rpx;
  bottom: -16rpx;
}
.ach-x:active {
  color: var(--text);
  background: rgba(255, 255, 255, 0.14);
}
.ach-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text);
  text-align: center;
}
/* —— 页签 —— */
.ach-tabs {
  margin-top: 22rpx;
  display: flex;
  gap: 12rpx;
  padding: 6rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.10);
  border: 1rpx solid var(--glass-line);
}
.ach-tab {
  position: relative;
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 17rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-sub);
  transition: color 0.18s ease, background 0.18s ease;
}
.ach-tab.on {
  color: #16213A;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  box-shadow: 0 4rpx 14rpx rgba(111, 227, 210, 0.3);
}
.ach-tab-num {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  opacity: 0.75;
  font-variant-numeric: tabular-nums;
}
.ach-stat {
  margin-top: 10rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  text-align: center;
  line-height: 1.6;
}
.ach-list {
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  margin-top: 22rpx;
  max-height: 52vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.ach-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.09);
  border: 1rpx solid var(--glass-line);
}
.ach-item.on {
  background: rgba(255, 216, 110, 0.16);
  border-color: rgba(255, 216, 110, 0.45);
}
.ach-badge {
  flex: none;
  width: 48rpx;
  font-size: 30rpx;
  text-align: center;
}
.ach-meta {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 14rpx;
  display: flex;
  flex-direction: column;
}
.ach-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ach-item:not(.on) .ach-name {
  color: var(--text-sub);
}
.ach-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-sub);
  word-break: break-all;
}
.set-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.set-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.10);
  border: 1rpx solid var(--glass-line);
}
.set-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin-right: 16rpx;
}
.set-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}
.set-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.4;
}
.switch {
  position: relative;
  min-width: 92rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 26rpx;
  font-size: 22rpx;
  font-weight: 800;
}
.switch.on {
  color: #16213A;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
}
.switch.off {
  color: var(--text-sub);
  background: rgba(255, 255, 255, 0.10);
}
.ach-close {
  margin-top: 28rpx;
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  text-align: center;
  border-radius: 41rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #16213A;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  transition: transform 0.16s ease;
}
.ach-close:active {
  transform: scale(0.97);
}
/* 排行榜 / 周挑战 / 补给站 的"完成"按钮（与 .ach-close 同款，修复此前未定义导致纯文本非按钮） */
.supply-close {
  margin-top: 24rpx;
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  text-align: center;
  border-radius: 41rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #16213A;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  transition: transform 0.16s ease;
}
.supply-close:active {
  transform: scale(0.97);
}

/* —— 关卡解锁面板（广告整合 v2，实底 panel 规范） —— */
.unlock-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 60;
  background: rgba(8, 10, 24, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  animation: fadeIn 0.2s ease both;
}
.unlock-card {
  position: relative;
  width: 100%;
  border-radius: 32rpx;
  padding: 44rpx 36rpx 36rpx;
}
.unlock-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text);
  text-align: center;
}
.unlock-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  text-align: center;
  line-height: 1.5;
}
.unlock-btn {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--panel-line);
  background: var(--panel-2);
  transition: transform 0.16s ease;
}
.unlock-btn:active {
  transform: scale(0.97);
}
.ub-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  flex-shrink: 0;
}
.unlock-btn.ad .ub-ico {
  color: #16213A;
  background: #FFD86E;
  box-shadow: 0 0 14rpx rgba(255, 216, 110, 0.55);
}
.unlock-btn.dust .ub-ico {
  color: #16213A;
  background: #6FE3D2;
  box-shadow: 0 0 14rpx rgba(111, 227, 210, 0.5);
}
.ub-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.ub-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
}
.ub-desc {
  font-size: 20rpx;
  color: var(--text-sub);
}

/* —— DEV 模拟广告层（全屏深色，流程与真机激励视频一致） —— */
.sim-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 90;
  background: #05060E;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.18s ease both;
}
.sim-x {
  position: absolute;
  top: calc(var(--sat) + 24rpx);
  right: 32rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.75);
}
.sim-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}
.sim-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #16213A;
  background: linear-gradient(135deg, #FFD86E, #FF9F6E);
  box-shadow: 0 0 40rpx rgba(255, 216, 110, 0.4);
}
.sim-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.sim-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.62);
}
.sim-bar {
  width: 320rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: rgba(255, 255, 255, 0.14);
  overflow: hidden;
}
.sim-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #FFD86E, #FF9F6E);
  transition: width 0.9s linear;
}
.sim-claim {
  position: absolute;
  bottom: calc(var(--sab) + 60rpx);
  left: 48rpx;
  right: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #16213A;
  background: linear-gradient(135deg, #FFD86E, #FFC94D);
}
.sim-claim:active {
  transform: scale(0.97);
}

/* —— 周挑战面板（P2） —— */
.weekly-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  max-height: 52vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.weekly-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 16rpx 22rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--panel-line);
  background: var(--panel-2);
  transition: transform 0.16s ease;
}
.weekly-item:active {
  transform: scale(0.97);
}
.weekly-item.done {
  opacity: 0.62;
}
.wi-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #16213A;
  background: linear-gradient(135deg, #6FE3D2, #4ECDC4);
  flex-shrink: 0;
}
.weekly-item.done .wi-num {
  background: rgba(255, 216, 110, 0.9);
}
.wi-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}
.wi-level {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.wi-mods {
  font-size: 20rpx;
  color: var(--text-sub);
  line-height: 1.5;
}
.wi-state {
  font-size: 26rpx;
  font-weight: 800;
  color: #FFD86E;
  flex-shrink: 0;
}
/* 三卡快捷行：窄屏下收紧内边距与图标，保证标题单行不换行 */
.quick-row.three {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.quick-row.three .quick-card {
  padding: 16rpx 14rpx;
}
.quick-row.three .quick-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
}
.quick-row.three .quick-meta {
  margin-left: 12rpx;
}
.quick-row.three .quick-badge {
  display: none;
}
/* 图鉴徽章 */
.codex-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  border: 2rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.05);
  flex-shrink: 0;
}
.codex-group {
  font-size: 20rpx;
  color: var(--text-sub);
  font-weight: 400;
}

/* ============ 生存 / 排行 两卡行 + 挑战码入口（P10） ============ */
.quick-row.two {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}
.quick-icon.survival {
  background: rgba(110, 231, 160, 0.20);
}
.quick-icon.rank {
  background: rgba(255, 216, 110, 0.20);
}
.challenge-entry {
  margin-top: 16rpx;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.ce-ico {
  font-size: 32rpx;
}
.ce-txt {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* ============ 挑战码面板 ============ */
.ch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid var(--panel-line, rgba(255,255,255,0.12));
}
.ch-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
}
.ch-value {
  font-size: 24rpx;
  color: var(--text-sub);
}
.ch-mods {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 18rpx 0;
}
.ch-mod {
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid transparent;
}
.ch-mod.on {
  color: #FFD86E;
  background: rgba(255, 216, 110, 0.14);
  border-color: rgba(255, 216, 110, 0.55);
}
.ch-gen {
  text-align: center;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 216, 110, 0.16);
  border: 2rpx solid rgba(255, 216, 110, 0.55);
  color: #FFD86E;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}
.ch-code {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.08);
  margin-bottom: 14rpx;
}
.ch-code-txt {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #6FE3D2;
}
.ch-copy {
  font-size: 24rpx;
  color: var(--text-sub);
}
.ch-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  padding: 8rpx 0;
}
.ch-paste {
  font-size: 24rpx;
  color: #6FE3D2;
  padding: 8rpx 0 8rpx 20rpx;
}
.ch-err {
  font-size: 22rpx;
  color: #FF7A92;
  padding: 8rpx 4rpx 0;
}
.ch-play {
  margin-top: 20rpx;
  text-align: center;
  padding: 20rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #FFD86E, #FF9F6E);
  color: #16213A;
  font-size: 30rpx;
  font-weight: 800;
}
.ch-play:active {
  transform: scale(0.97);
}

/* ============ 排行榜列表（卡片式，与周挑战条目同构） ============ */
.rank-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 88rpx;
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--panel-line);
  background: var(--panel-2);
}
.rank-time {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}
.rk-stars {
  font-size: 22rpx;
  line-height: 1.3;
  color: #FFD86E;
}
.rk-time {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.3;
  color: var(--text);
}

/* ============ 皮肤解锁动效（vanity） ============ */
.skin-fx {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  animation: skinFade 1.6s ease both;
}
.skin-fx-ring {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 216, 110, 0.8);
  animation: skinRing 1.4s ease-out both;
}
.skin-fx-txt {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFD86E;
  text-shadow: 0 0 24rpx rgba(255, 216, 110, 0.8);
}
@keyframes skinRing {
  0% { transform: scale(0.3); opacity: 1; }
  100% { transform: scale(1.6); opacity: 0; }
}
@keyframes skinFade {
  0%, 70% { opacity: 1; }
  100% { opacity: 0; }
}
